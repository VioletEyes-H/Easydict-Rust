{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "translate-tauri",
  "version": "0.1.0",
  "identifier": "com.keke.translate-tauri",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "translate-tauri",
        "width": 600,
        "minWidth": 360,
        "decorations": false,
        "transparent": true,
        "acceptFirstMouse": true,
        "alwaysOnTop": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
